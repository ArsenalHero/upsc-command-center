{
  "name": "upsc-command-center-pages",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "app"
  ],
  "scripts": {
    "dev": "npm --workspace app run dev",
    "build": "npm --workspace app run build && node app/scripts/publish-pages.mjs",
    "preview": "npm --workspace app run preview",
    "typecheck": "npm --workspace app run typecheck",
    "test": "npm --workspace app run test",
    "test:ui": "npm --workspace app run test:ui"
  }
}
